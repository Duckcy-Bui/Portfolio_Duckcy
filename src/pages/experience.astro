---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Experience" description="Bui Hai Duc’s internship at NestScale, Information Technology studies at UTC and technical mentoring with SFIT Club.">
      <section id="experience" class="section experience">
        <div class="container">
          <div class="section-title">
            <p class="eyebrow">Experience</p>
            <h1>Internship, Education &amp; Activities</h1>
          </div>

          <div class="timeline">
            <div class="timeline-item">
              <div class="time">Present</div>
              <div class="detail">
                <div class="timeline-org">
                  <img
                    class="timeline-logo"
                    width="56"
                    height="56"
                    src="/assets/logo_nestscale.png"
                    alt="NestScale logo"
                    loading="lazy"
                  />
                  <h3>NestScale</h3>
                </div>
                <p>Software Engineer Intern - Đê La Thành, Hà Nội. Building software engineering experience with a DevOps-oriented mindset.</p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time">2023 - Present</div>
              <div class="detail">
                <div class="timeline-org">
                  <img
                    class="timeline-logo"
                    width="56"
                    height="56"
                    src="/assets/logo_utc.webp"
                    alt="University of Transport logo"
                    loading="lazy"
                  />
                  <h3>University of Transport</h3>
                </div>
                <p>IT Major - Year 3 Student - GPA 3.4</p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="time">2023 - Present</div>
              <div class="detail">
                <div class="timeline-org">
                  <img
                    class="timeline-logo"
                    width="56"
                    height="56"
                    src="/assets/logo_sfit.jpeg"
                    alt="SFIT Club logo"
                    loading="lazy"
                  />
                  <h3>SFIT Club - Technical & Cloud Committee</h3>
                </div>
                <p>
                  Planning and coordinating workshops, mentoring fundamental programming courses,
                  connecting members and promoting project-based learning.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

</SiteLayout>
