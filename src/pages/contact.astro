---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact" description="Contact Bui Hai Duc about software engineering opportunities and collaboration. Find email, LinkedIn, phone and CV here.">
      <section id="contact" class="section contact">
        <div class="container contact-card">
          <div>
            <p class="eyebrow">Contact</p>
            <h1>Ready to Collaborate</h1>
            <div class="contact-details">
              <a href="mailto:duckcy.work@gmail.com" class="copy-email" data-copy-email="duckcy.work@gmail.com" title="Click to copy email">
                <span class="contact-icon">✉</span>
                <span class="contact-text">duckcy.work@gmail.com</span>
                <span class="copy-hint">Click to copy</span>
              </a>
              <a href="tel:+84976795113">
                <span class="contact-icon">☎</span>
                <span class="contact-text">+84 97 679 5113</span>
              </a>
              <div class="contact-location">
                <span class="contact-icon">📍</span>
                <span class="contact-text">No. 3, Cau Giay, Hanoi</span>
              </div>
              <div class="contact-actions">
                <a class="btn primary" href="/assets/CV_bui_hai_duc.pdf" target="_blank" rel="noopener noreferrer">📄 Download CV</a>
                <a class="btn ghost" href="https://www.linkedin.com/in/duckcy/" target="_blank" rel="noopener noreferrer">💼 LinkedIn</a>
              </div>
            </div>
          </div>

          <noscript><style>#contact-form { display: none; }</style><p class="form-note">To send a message, use the email link on this page. The draft form requires JavaScript.</p></noscript>
          <form class="contact-form" id="contact-form" novalidate>
            <div class="form-group">
              <label for="cf-name">Your Name</label>
              <input type="text" id="cf-name" name="name" placeholder="Nguyen Van A" autocomplete="name" required data-validate="name" minlength="2" maxlength="100" />
              <span class="field-error" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label for="cf-email">Your Email</label>
              <input type="email" id="cf-email" name="email" placeholder="you@example.com" autocomplete="email" required data-validate="email" maxlength="254" />
              <span class="field-error" aria-live="polite"></span>
            </div>
            <div class="form-group">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" placeholder="Tell me about the opportunity..." rows="5" required data-validate="message" minlength="10" maxlength="5000"></textarea>
              <span class="field-error" aria-live="polite"></span>
            </div>
            <button type="submit" class="btn primary form-submit">
              <span class="submit-text">Open email app</span>
              <span class="submit-icon">→</span>
            </button>
            <div class="form-tools"><button type="button" class="btn ghost" data-contact-copy>Copy draft</button><button type="button" class="btn ghost" data-contact-clear>Clear</button></div>
            <p class="form-note">Opens a draft in your email app. Review and send it there.</p>
            <p class="form-status" data-contact-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
<script>import { initContact } from '../scripts/contact'; initContact();</script>
</SiteLayout>
