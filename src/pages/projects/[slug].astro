---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/portfolio';
import SbltContent from '../../content/projects/sblt-cup.md';
import ClassesContent from '../../content/projects/classes369.md';
import InvestorContent from '../../content/projects/investor-ai.md';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const articles = { 'sblt-cup': SbltContent, 'classes369': ClassesContent, 'investor-ai': InvestorContent };
const Content = articles[project.slug as keyof typeof articles];
const next = projects[(projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length];
---
<SiteLayout title={`${project.name} — Project`} description={project.summary}><div class="container page">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav>
  <div class="project-detail-heading"><PageHeading eyebrow={project.category} title={project.name} description={project.summary} /></div>
  <dl class="detail-meta"><div><dt>My role</dt><dd>{project.role}</dd></div><div><dt>Period</dt><dd>{project.period}</dd></div><div><dt>Explore the source</dt><dd><a class="text-link" href={project.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={14} /></a></dd></div></dl>
  <ProjectVisual kind={project.illustration} />
  <div class="project-detail-grid"><article class="prose"><Content /></article><aside class="detail-sidebar"><div class="panel"><h2>Technology stack</h2><div class="tags">{project.stack.map((tech) => <span>{tech}</span>)}</div><a class="btn btn-primary" href={project.github} target="_blank" rel="noopener noreferrer">View source <Icon name="arrow" size={16} /></a><a class="text-link section-space" href="/contact/">Ask about this project →</a></div></aside></div>
  <div class="project-next"><div><p>Next project</p><a href={`/projects/${next.slug}/`}>{next.name}<Icon name="right" /></a></div><a class="text-link" href="/projects/">All projects</a></div>
</div></SiteLayout>
