---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import { skillGroups } from '../data/portfolio';
---
<SiteLayout title="Skills" description="Bui Hai Duc’s toolkit for backend development, DevOps, databases and engineering practices: Docker, Linux, Python, Java and more."><div class="container page">
  <PageHeading eyebrow="My toolkit" title="Tools with a purpose" description="The technologies and practices I use to build applications and support their delivery." />
  <div class="skill-tabs" role="tablist" aria-label="Skill categories" hidden data-skills-controls>{skillGroups.map((group, index) => <button id={`tab-${group.id}`} type="button" role="tab" data-skill-tab={group.id} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${group.id}`} tabindex={index === 0 ? 0 : -1}>{group.name}</button>)}</div>
  {skillGroups.map((group) => <section class="skill-panel" id={`panel-${group.id}`} data-skill-panel={group.id} aria-labelledby={`heading-${group.id}`}><h2 id={`heading-${group.id}`}>{group.name}</h2><p>{group.description}</p><div class="skill-grid">{group.items.map((item) => <div class="skill-card"><img src={`/assets/${item.icon}`} alt="" width="35" height="35" loading="lazy" /><span>{item.name}</span></div>)}</div></section>)}
  <p class="skill-footnote">See these tools in context in <a class="text-link" href="/projects/">my projects →</a>.</p>
  <script>import { initSkills } from '../scripts/skills'; document.querySelector('[data-skills-controls]')?.removeAttribute('hidden'); initSkills();</script>
</div></SiteLayout>
