---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { certificates } from '../data/portfolio';
---
<SiteLayout title="Certificates" description="Verify Bui Hai Duc’s AWS Student Builder Group Core Team Member Badge, issued by AWS Community in July 2026."><div class="container page">
  <PageHeading eyebrow="Credentials & recognition" title="Learning, backed by evidence" description="Credentials with a direct link to their issuing source." />
  {certificates.map((certificate) => <article class="panel certificate-card"><div><p class="overline">{certificate.issuer} · Issued {certificate.issued}</p><h2>{certificate.title}</h2><p>{certificate.description}</p><div class="tags">{certificate.skills.map((skill) => <span>{skill}</span>)}</div><a class="btn btn-primary" href={certificate.url} target="_blank" rel="noopener noreferrer">Verify on Credly <Icon name="arrow" size={17} /></a></div><div class="badge-preview" data-credly-badge><div data-iframe-width="150" data-iframe-height="270" data-share-badge-id={certificate.badgeId} data-share-badge-host="https://www.credly.com"><noscript>View the original badge using the verification link.</noscript></div></div></article>)}
  <p class="certificate-note">Every credential listed here links to its original source. More will be added as they are earned.</p>
  <script>import { initCertificates } from '../scripts/certificates'; initCertificates();</script>
</div></SiteLayout>
