---
import { Image } from 'astro:assets';
import portrait from '../../assets/hai_duc_img-removebg-preview.png';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GameLaunch from '../components/GameLaunch.astro';
import Icon from '../components/Icon.astro';
import { profile, projects } from '../data/portfolio';
---
<SiteLayout title="Software Engineering & DevOps" description="Bui Hai Duc’s portfolio: backend engineering, Docker, CI/CD and Linux. Explore projects, experience, skills and verified credentials.">
  <section class="hero"><div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span>Software engineering · DevOps mindset</p>
      <h1>Bui Hai Duc<span class="accent">.</span></h1>
      <p class="hero-role">From backend systems<br />to reliable deployment.</p>
      <p class="hero-summary">{profile.summary}</p>
      <div class="actions"><a class="btn btn-primary" href={profile.cv} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17} />Download CV</a><a class="btn" href="/contact/">Let’s connect <Icon name="arrow" size={16} /></a><GameLaunch /></div>
      <p class="hero-note"><Icon name="pin" size={14} />Hanoi, Vietnam <span aria-hidden="true">·</span> Software Engineering Intern</p>
    </div>
    <div class="portrait-card"><div class="portrait-top"><span>~/duckcy/profile</span><span>01 — HELLO</span></div><div class="portrait-stage"><Image src={portrait} width={300} format="webp" quality={85} alt="Portrait of Bui Hai Duc" class="portrait-image" loading="eager" fetchpriority="high" /></div><div class="portrait-caption"><div><strong>Build. Deploy. Improve.</strong><span>Backend · Docker · Linux · CI/CD</span></div><span class="code-glyph" aria-hidden="true">&lt;/&gt;</span></div></div>
  </div></section>
  <section class="home-section"><div class="container"><div class="section-header"><div><p class="overline">Selected work</p><h2>Ideas put into practice<span class="accent">.</span></h2><p>A look at the systems I’ve helped build.</p></div><a class="text-link" href="/projects/">All projects <Icon name="arrow" size={16} /></a></div><div class="project-grid">{projects.filter((p) => p.featured).map((project) => <ProjectCard project={project} />)}</div></div></section>
  <section class="home-section"><div class="container"><div class="quick-links"><a href="/about/" class="quick-link"><div><h3>The person behind the code</h3><p>Background, education and how I work.</p></div><Icon name="arrow" /></a><a href="/experience/" class="quick-link"><div><h3>Experience & community</h3><p>Learning through work and collaboration.</p></div><Icon name="arrow" /></a><a href="/certificate/" class="quick-link"><div><h3>Credentials you can verify</h3><p>Badges and their original sources.</p></div><Icon name="arrow" /></a></div></div></section>
</SiteLayout>
