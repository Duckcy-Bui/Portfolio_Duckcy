---
const pathname = Astro.url.pathname;
---
<header class="site-header">
      <div class="container nav-bar">
        <div class="brand" id="theme-brand">
          <span class="brand-dot"></span>
          <span class="brand-text">THEME</span>
          <button class="brand-pill" id="theme-pill-btn" aria-haspopup="menu" aria-controls="theme-picker" aria-expanded="false" aria-label="Select theme">
            <span id="theme-pill-label">Outer Space</span>
            <svg class="brand-pill-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </button>
          <div class="theme-picker" id="theme-picker" role="menu" aria-label="Theme options">
            <button class="theme-picker-item" data-theme-key="dark" role="menuitem"><span class="theme-picker-dot" style="background:#5cc5ff"></span>Outer Space</button>
            <button class="theme-picker-item" data-theme-key="light" role="menuitem"><span class="theme-picker-dot" style="background:#d4a800"></span>Daylight</button>
            <button class="theme-picker-item" data-theme-key="forest" role="menuitem"><span class="theme-picker-dot" style="background:#4ade80"></span>Forest Terminal</button>
            <button class="theme-picker-item" data-theme-key="ocean" role="menuitem"><span class="theme-picker-dot" style="background:#22d3ee"></span>Deep Ocean</button>
            <button class="theme-picker-item" data-theme-key="sunset" role="menuitem"><span class="theme-picker-dot" style="background:#f97316"></span>Sunset Ember</button>
          </div>
        </div>

        <nav id="site-nav" class="nav-links" aria-label="Main navigation" data-nav="">
          <a href="/" class:list={{ active: pathname === '/' }} aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <div class="nav-dropdown-wrap">
            <button class:list={{ "nav-dropdown-btn": true, active: pathname.startsWith("/about/") || pathname.startsWith("/certificate/") }} aria-current={pathname.startsWith("/about/") || pathname.startsWith("/certificate/") ? 'page' : undefined} aria-haspopup="true" aria-expanded="false" data-nav-dropdown="">
              About
              <svg class="nav-dropdown-chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
            <div class="nav-dropdown" role="menu">
              <a href="/about/" data-tab-target="overview" role="menuitem">Overview</a>
              <a href="/about/#education" data-tab-target="education" role="menuitem">Education</a>
              <a href="/certificate/" role="menuitem">Certificates</a>
              <a href="/about/#testimonials" data-tab-target="testimonials" role="menuitem">Testimonials</a>
            </div>
          </div>
          <a href="/skills/" class:list={{ active: pathname === '/skills/' }} aria-current={pathname === '/skills/' ? 'page' : undefined}>Skills</a>
          <a href="/projects/" class:list={{ active: pathname.startsWith('/projects/') }} aria-current={pathname.startsWith('/projects/') ? 'page' : undefined}>Projects</a>
          <a href="/experience/" class:list={{ active: pathname === '/experience/' }} aria-current={pathname === '/experience/' ? 'page' : undefined}>Experience</a>
          <a href="/contact/" class:list={{ active: pathname === '/contact/' }} aria-current={pathname === '/contact/' ? 'page' : undefined}>Contact</a>
        </nav>

        <div class="nav-actions">
          <!-- Social icon group -->
          <div class="nav-social-group">
            <a class="icon-button" href="https://www.linkedin.com/in/duckcy/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <!-- LinkedIn -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
            </a>
            <a class="icon-button" href="https://github.com/Duckcy-Bui" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <!-- GitHub -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
            </a>
            <a class="icon-button" href="https://www.facebook.com/HaiDuc12528/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <!-- Facebook -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            </a>
          </div>

          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2a10 10 0 0 1 0 20"></path>
              <path d="M12 2v20M2 12h20"></path>
            </svg>
          </button>
          <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-controls="site-nav" aria-expanded="false" data-nav-toggle="">
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>
