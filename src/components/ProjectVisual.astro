---
interface Props { kind: string; compact?: boolean; }
const { kind, compact = false } = Astro.props;
---
<div class:list={['project-visual', `visual-${kind}`, { compact }]} aria-hidden="true">
  <div class="visual-grid"></div>
  {kind === 'tournament' && <svg viewBox="0 0 420 200" fill="none"><g stroke="currentColor" stroke-width="1.5"><path d="M80 50h65v100H80M145 100h65M275 50h65M275 150h65M275 50v100M210 100h65"/><rect x="25" y="32" width="100" height="36" rx="9"/><rect x="25" y="132" width="100" height="36" rx="9"/><rect x="295" y="32" width="100" height="36" rx="9"/><rect x="295" y="132" width="100" height="36" rx="9"/><rect x="160" y="74" width="100" height="52" rx="12"/></g><g fill="currentColor"><circle cx="48" cy="50" r="4"/><circle cx="48" cy="150" r="4"/><circle cx="372" cy="50" r="4"/><circle cx="372" cy="150" r="4"/><path d="m210 90 3.5 7 7.7 1.1-5.6 5.4 1.3 7.7-6.9-3.6-6.9 3.6 1.3-7.7-5.6-5.4 7.7-1.1z"/></g></svg>}
  {kind === 'classroom' && <svg viewBox="0 0 420 200" fill="none"><g stroke="currentColor" stroke-width="1.5"><rect x="72" y="26" width="276" height="148" rx="13"/><path d="M72 58h276M135 58v116"/><rect x="153" y="78" width="174" height="23" rx="5"/><rect x="153" y="110" width="174" height="23" rx="5"/><path d="M163 88h69m-69 32h104m-114 27h58M89 80h27m-27 17h19m-19 17h23"/></g><g fill="currentColor"><circle cx="89" cy="43" r="3"/><circle cx="101" cy="43" r="3"/><circle cx="113" cy="43" r="3"/><circle cx="312" cy="89" r="3"/><circle cx="312" cy="121" r="3"/></g></svg>}
  {kind === 'pipeline' && <svg viewBox="0 0 420 200" fill="none"><g stroke="currentColor" stroke-width="1.5"><rect x="36" y="74" width="74" height="52" rx="10"/><rect x="173" y="74" width="74" height="52" rx="10"/><rect x="310" y="74" width="74" height="52" rx="10"/><path d="M110 100h63m74 0h63m-146-5 9 5-9 5m137-10 9 5-9 5M210 74V39m0 87v35"/><circle cx="210" cy="27" r="12"/><circle cx="210" cy="173" r="12"/><path d="m55 91 18-8 18 8-18 8-18-8Zm0 0v17l18 8 18-8V91M73 99v17M198 106l7-17 9 24 8-20M330 94h34m-34 8h25m-25 8h29"/></g></svg>}
  <span class="visual-caption">{kind === 'tournament' ? 'COMPETE · PREDICT · CONNECT' : kind === 'classroom' ? 'APPLICATION · API · DEPLOYMENT' : 'INGEST · PROCESS · DELIVER'}</span>
</div>
