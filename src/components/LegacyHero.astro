---
import { Image } from 'astro:assets';
import portrait from '../../assets/hai_duc_img-removebg-preview.png';
import GameLaunch from './GameLaunch.astro';
import '../styles/hero.css';
---
<section id="home" class="hero">
        <div class="container hero-grid">

          <!-- LEFT: eyebrow, heading, lead, code block, CTA -->
          <div class="hero-copy">
            <div class="hero-intro">
            <p class="eyebrow">
              <span class="eyebrow-bar" aria-hidden="true"></span>
              Welcome to my portfolio
            </p>
            <h1>
              Bui Hai Duc
              <span>Software Engineering Intern</span>
            </h1>
            </div>
            <!-- <p class="lead">
              3rd year IT student at University of Transport. Passionate about Software Engineering with a DevOps orientation, focused on backend systems, Docker, CI/CD, Linux, and robust deployments.
            </p> -->

            <div class="cta-group">
              <a class="btn primary" href="/assets/CV_bui_hai_duc.pdf" target="_blank" rel="noopener noreferrer">
                <span class="btn-icon">⬇</span> Download CV <span class="btn-arrow">→</span>
              </a>
              <a class="btn ghost hero-contact-action" href="/contact/">
                <span class="btn-icon">◯</span> Let's Connect <span class="btn-arrow">→</span>
              </a>
              <GameLaunch />
            </div>

            <div class="code-card">
              <div class="code-header">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="code-title">software_engineering_profile.yaml</span>
              </div>
              <pre tabindex="0" role="region" aria-label="Software engineering profile in YAML"><code data-animate-lines="">---
user:
  name: "Bui Hai Duc"
  role: ["Software Engineering Intern"]
  orientation: "DevOps"
  current_internship:
    company: "NestScale"
    position: "Software Engineer Intern"
    location: "Đê La Thành, Hà Nội"

education:
  university: "University of Transport and Communications"
  year: 3
  gpa: 3.4

core_focus:
  - Backend Engineering
  - Docker &amp; Containerized Deployment
  - CI/CD Pipelines
  - Linux Operations
</code></pre>
            </div>

          </div>

          <!-- RIGHT: avatar circle, name/title, action buttons, stats -->
          <div class="hero-visual">
            <div class="profile-card">
              <div class="avatar-ring">
                <Image src={portrait} width={320} format="webp" quality={95} alt="Bui Hai Duc profile image" loading="eager" fetchpriority="high" />
              </div>
              <div class="profile-info">
                <h2>Software Engineering Intern</h2>
                <p>DevOps-oriented | Docker | Linux | CI/CD</p>
              </div>
              <div class="profile-actions">
                <!-- Email icon -->
                <a class="profile-icon-btn" href="mailto:duckcy.work@gmail.com" aria-label="Send email">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                </a>
                <!-- Phone icon -->
                <a class="profile-icon-btn" href="tel:+84976795113" aria-label="Call">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.08 6.08l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </a>
                <!-- LinkedIn icon -->
                <a class="profile-icon-btn" href="https://www.linkedin.com/in/duckcy/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                </a>
                <!-- GitHub icon -->
                <a class="profile-icon-btn" href="https://github.com/Duckcy-Bui" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
                </a>
                <!-- Facebook icon -->
                <a class="profile-icon-btn" href="https://www.facebook.com/HaiDuc12528/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
                </a>
              </div>
              <!-- <div class="stats">
                <div class="stat-card">
                  <p class="stat-number">3.4/4.0</p>
                  <p class="stat-label">GPA</p>
                </div>
                <div class="stat-card">
                  <p class="stat-number">Year 3</p>
                  <p class="stat-label">CS - UTC</p>
                </div>
                <div class="stat-card">
                  <p class="stat-number">3+</p>
                  <p class="stat-label">Projects</p>
                </div>
              </div> -->
            </div>
          </div>

        </div>
      </section>
