---
import '../styles/projects.css';
import type { Project } from '../data/portfolio';
interface Props { project: Project; filterable?: boolean; }
const { project, filterable = false } = Astro.props;
const descriptions: Record<string, string> = {
  "sblt-cup": "Built for SBLT YouTube team's TFT tournament (May 2026). Designed a multi-stage tournament system (5 types, 8 groups × 8 players) with automated advancement and prediction system featuring time-window control and auto-scoring. Implemented real-time updates via SSE + Redis Pub/Sub (5000+ concurrent connections) with cross-instance broadcasting for PM2 cluster. Built 3-channel notification system (Database, Email, Push) with batch processing solving N+1 queries, and optimized caching with Redis stampede protection. Developed composite player rating algorithm (0–1000 score) based on 4 weighted factors.",
  "classes369": "Delivered a modular, production-oriented Flask API with 11+ Blueprint modules and robust DB transaction handling. Designed authentication flow supporting bcrypt, role-based access (Admin / Teacher / Student), and RESTful endpoints. Implemented core business logic: transactional enrollment, cascading deletes, and payments handling. Automated reproducible Docker-based deployment (app + SQL Server + db-init) with automated schema seeding, persistent volumes, healthchecks, and retry/backoff mechanisms to avoid race conditions.",
  "investor-ai": "Architected scalable containerized deployment for 12 services, enabling daily processing of financial data via 13 Airflow DAGs. Created and maintained Docker images and docker-compose configurations for consistent environments. Built automated CI/CD pipelines (build → test → deploy) with rollback support for backend and frontend. Prepared GPU- and Spark-enabled containers for reproducible LSTM model training and inference with CUDA tuning. Implemented centralized logging, alerting, and SLOs to monitor system reliability."
};
const subtitles: Record<string, string> = {
  "sblt-cup": "Tournament Management Platform",
  "classes369": "IT center student management system",
  "investor-ai": "AI-powered stock analysis & prediction platform"
};
const overviews: Record<string, { summary: string; highlight: string }> = {
  'sblt-cup': {
    summary: 'A TFT tournament platform for multi-stage competition, predictions and live updates.',
    highlight: 'Live updates through SSE and Redis Pub/Sub.',
  },
  'classes369': {
    summary: 'A Flask API for student management, with role-based access and Docker deployment.',
    highlight: 'Transactional enrollment and repeatable database setup.',
  },
  'investor-ai': {
    summary: 'Infrastructure and data pipelines for an AI-powered stock analysis platform.',
    highlight: 'Daily data processing with Airflow and CI/CD rollback support.',
  },
};
const overview = overviews[project.slug];
const visibleStack = project.stack.slice(0, 4);
const remainingTechnologies = project.stack.length - visibleStack.length;
const detailPath = `/projects/${project.slug}/`;
---
<article class="project-showcase project-card" data-project={filterable || undefined} data-tags={project.stack.join(',')} data-text={[project.name, project.category, project.role, overview?.summary || project.summary, overview?.highlight || '', descriptions[project.slug] || project.summary, ...project.stack].join(' ')}>
  <div class="project-showcase-body">
    <div class="project-card-heading">
      <div>
        <h2 class="project-showcase-title"><a href={detailPath}>{project.name}</a></h2>
        <p class="project-showcase-sub">{subtitles[project.slug] || project.category}</p>
      </div>
      <p class="project-card-role"><span>My role</span><strong>{project.role}</strong></p>
    </div>
    <p class="project-showcase-desc">{overview?.summary || project.summary}</p>
    {overview && <p class="project-card-highlight"><span aria-hidden="true">↳</span><span><span class="sr-only">Project highlight: </span>{overview.highlight}</span></p>}
    <div class="project-showcase-tags" aria-label="Technology stack">
      {visibleStack.map((tech) => <span>{tech}</span>)}
      {remainingTechnologies > 0 && <a class="project-card-more" href={detailPath} aria-label={`View all ${project.stack.length} technologies for ${project.name}`}>+{remainingTechnologies} technologies <span aria-hidden="true">→</span></a>}
    </div>
    <div class="project-showcase-actions">
      <a class="project-github-btn" href={project.github} target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>View on GitHub</a>
      <a class="project-github-btn" href={detailPath} aria-label={`Explore ${project.name}`}>Explore project <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
