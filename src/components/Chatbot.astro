---
import '../styles/chatbot.css';
---
<div class="chatbot-launch">
  <div id="chatbot-fab-tooltip" class="chatbot-tooltip" hidden>
    <span>Ask about my work.</span>
    <button type="button" id="chatbot-tooltip-close" aria-label="Dismiss assistant tip">×</button>
  </div>
  <button type="button" id="chatbot-fab" class="chatbot-fab" aria-label="Ask Duc’s assistant" aria-haspopup="dialog" aria-controls="chatbot-window">
    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg>
  </button>
</div>
<dialog id="chatbot-window" class="chatbot-window" aria-labelledby="chatbot-title" aria-describedby="chatbot-description">
  <header class="chatbot-header">
    <div><h2 id="chatbot-title">Duc’s assistant</h2><p id="chatbot-description">Skills, projects, and ways to get in touch.</p></div>
    <button type="button" id="chatbot-close" class="chatbot-icon-button" aria-label="Close assistant">×</button>
  </header>
  <div class="chatbot-messages" role="log" aria-live="polite" aria-relevant="additions" aria-label="Conversation" tabindex="0"></div>
  <div class="chatbot-suggestions" aria-label="Suggested questions">
    <button type="button" data-chat-suggestion="What are Duc's skills?">Skills</button>
    <button type="button" data-chat-suggestion="Tell me about Duc's projects">Projects</button>
    <button type="button" data-chat-suggestion="How can I contact Duc?">Contact</button>
  </div>
  <form id="chatbot-form" class="chatbot-form">
    <label for="chatbot-input" class="chatbot-sr-only">Message for Duc’s assistant</label>
    <textarea id="chatbot-input" name="message" rows="2" maxlength="2000" placeholder="Ask about Duc’s work…" required></textarea>
    <button type="submit" id="chatbot-send" aria-label="Send message">Send</button>
  </form>
  <footer class="chatbot-footer"><span>AI can make mistakes. Check the portfolio for details.</span><button type="button" id="chatbot-reset" aria-label="Clear conversation">Clear</button></footer>
</dialog>
<noscript><style>.chatbot-launch { display: none; }</style></noscript>
<script>
  import { initChatbot } from '../scripts/chatbot';
  initChatbot();
</script>
